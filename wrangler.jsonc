{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracked",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "observability": { "enabled": true },
  // Two crons:
  //   - "*/5 * * * *"    heartbeat: one scheduler tick (src/lib/fetch-scheduler.ts)
  //                      submits a small random number (default 0-3) of due
  //                      1001tracklists fetches to tlpool, highest priority
  //                      first (DJ discovery / new sets, verification second
  //                      fetches, rechecks by set age, DJ backfill), and stops
  //                      at the pool's first refusal. tlpool owns budget and
  //                      pacing; nothing bursts.
  //   - "0 6 * * *"      daily housekeeping only (audit pruning). DJ discovery
  //                      is spread around the clock by the scheduler instead.
  // Both then reconcile the combined "All tracked artists" playlist against
  // the per-artist ones (YouTube only; bounded per run and per day — see
  // lib/combined-playlist.ts), and retry Web Pushes whose delivery failed.
  "triggers": { "crons": ["0 6 * * *", "*/5 * * * *"] },
  // Queryable state: subscriptions, per-tracklist sync rows, both audit trails,
  // the mkvid queue. Schema in migrations/; apply with `npm run d1:migrate`
  // BEFORE pushing (Workers Builds runs `wrangler deploy` only — it never
  // applies migrations). Create with `npx wrangler d1 create tracked`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracked",
      "database_id": "9c3d6c10-4a1e-47d0-869f-332a19d47828",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "8cb267cd79b346baa86d37ec9e1015ef",
      "preview_id": "c13978cb82b249f6b2b8939f92d1dad9"
    },
    {
      // Durable storage for the /subscriptions mini-app (DJ slugs the user
      // wants tracked). No TTLs; kept separate from CACHE so we never wipe it
      // by mistake. Create with:
      //   npx wrangler kv namespace create SUBS
      //   npx wrangler kv namespace create SUBS --preview
      // and paste the ids here.
      "binding": "SUBS",
      "id": "6189a771499e43fe80544efd63bd7830",
      "preview_id": "9afbf5f55a5541a88c6685bcc1fea10b"
    }
  ],
  // Every 1001tracklists page tlpool returns, gzip, kept for troubleshooting (lib/page-store.ts).
  // Bucket lifecycle by prefix: flagged/ 180 d, clean/ 30 d, other/ 30 d.
  "r2_buckets": [{ "binding": "PAGES", "bucket_name": "tracked-pages" }],
  "vars": {
    // Cloudflare Access team domain (e.g. "yourteam.cloudflareaccess.com").
    // The /subscriptions/* routes verify the Cf-Access-Jwt-Assertion header
    // against this team's JWKS. Leave blank locally and set DEV_BYPASS_CF_ACCESS=1
    // in .dev.vars to skip verification during `wrangler dev`.
    "CF_ACCESS_TEAM_DOMAIN": "pmaxhogan.cloudflareaccess.com",
    // Application AUD tag from the Cloudflare Access app config. Set this in
    // wrangler.jsonc (it's not a secret) so the deployed worker rejects
    // tokens minted for any other Access app.
    "CF_ACCESS_AUD": "2e506a47b5074faa2f414e1d8e2bd80b3a19ba75b1a7e8b0608926b1bafc2ad8",
    // Comma-separated list of email addresses allowed to use the mini-app.
    // The CF Access policy should already restrict this, but we double-check
    // here so a misconfigured policy can't grant access.
    "CF_ACCESS_ALLOWED_EMAILS": "pmaxhogan@gmail.com"
  }
  // Secrets (set via `wrangler secret put`):
  //   API_TOKEN                  bearer token Tasker uses
  //   LIKED_SONGS_TOKEN          separate bearer token for GET /liked-songs (agents/scripts)
  //   MKVID_TOKEN                bearer mkvid presents on /mkvid/*; also enables queueing sets for it
  //   MKVID_DAILY_CLAIM_CAP      (optional) uploads/day through mkvid's own Google project, mkvid-uploads (default 24; 0 pauses).
  //                              A secret overrides the code default: delete it (or set it) when the default changes.
  //   MKVID_SHARED_DAILY_CLAIM_CAP (optional) uploads/day through the sync's project, tracked-youtube, once the first is full (default 6)
  //   YOUTUBE_API_KEY            YouTube Data API v3 key
  //   TLPOOL_URL                 tlpool (the NAS browser pool) through the tunnel; every 1001tracklists request goes there
  //   TLPOOL_TOKEN               bearer for tlpool, both directions (Worker → POST /fetch, tlpool → POST /pool/events)
  //   GOOGLE_OAUTH_CLIENT_ID     OAuth client id for YouTube playlist write access
  //   GOOGLE_OAUTH_CLIENT_SECRET matching client secret
  //   VAPID_PUBLIC_KEY           Web Push identity for the admin page's IP-ban alerts
  //   VAPID_PRIVATE_KEY          (node scripts/gen-vapid-keys.mjs prints all three)
  //   VAPID_SUBJECT              mailto: contact required by push services
}
