{
  "name": "tracked",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "d1:migrate": "wrangler d1 migrations apply tracked --remote",
    "d1:migrate:local": "wrangler d1 migrations apply tracked --local",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:ascii": "node scripts/check-ascii.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@hono/zod-openapi": "^0.18.4",
    "he": "^1.2.0",
    "hono": "^4.7.0",
    "node-html-parser": "^7.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.4",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^10.0.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@types/he": "^1.2.3",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "~2.1.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "undici": "^7.29.1",
    "vitest": "~2.1.9",
    "wrangler": "^4.87.0"
  },
  "engines": {
    "node": ">=22"
  }
}
