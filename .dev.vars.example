API_TOKEN=replace-with-a-long-random-string
# Separate bearer for GET /liked-songs (hand this one to agents; it can't drive the Tasker routes).
LIKED_SONGS_TOKEN=replace-with-a-different-long-random-string
# Optional. Bearer mkvid presents on /mkvid/* (same value as TRACKED_TOKEN in mkvid's .env).
# While unset, the sync never queues a set for mkvid.
# MKVID_TOKEN=replace-with-another-long-random-string
# mkvid's base URL, for deleting videos a "Delete and recreate" replaced (optional Access service token).
# MKVID_URL=https://mkvid.example.com
# MKVID_ACCESS_CLIENT_ID=
# MKVID_ACCESS_CLIENT_SECRET=
YOUTUBE_API_KEY=replace-with-google-cloud-yt-data-api-key
# tlpool, the NAS browser pool. EVERY 1001tracklists request goes through it
# (README "Network strategy"); while unset nothing is fetched from
# 1001tracklists at all. TLPOOL_TOKEN is also what tlpool presents on
# POST /pool/events.
# TLPOOL_URL=https://tlpool.example.com
# TLPOOL_TOKEN=replace-with-a-long-random-string

# /subscriptions mini-app — Cloudflare Access gate.
# In prod these come from wrangler.jsonc `vars`. For `wrangler dev` you can
# either set them to your real Access team/app and tunnel through cloudflared,
# or set DEV_BYPASS_CF_ACCESS=1 below to skip verification entirely.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=replace-with-the-app-aud-tag
# CF_ACCESS_ALLOWED_EMAILS=you@example.com
DEV_BYPASS_CF_ACCESS=1

# Google OAuth 2.0 client credentials for YouTube playlist write access.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console,
# enable the YouTube Data API v3, and add an authorized redirect URI of
#   <your-worker-host>/subscriptions/oauth/callback
# (for `wrangler dev` via the cloudflared tunnel, the trycloudflare.com host).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional. Uploads mkvid may make per YouTube quota day through its own Google
# project (default 6; 0 pauses) and, once that is used up, through the sync's
# project (default 0 = never; 3 in production).
# MKVID_DAILY_CLAIM_CAP=6
# MKVID_SHARED_DAILY_CLAIM_CAP=3
